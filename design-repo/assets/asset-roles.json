{
  "version": "1.0.0",
  "sourceIsRealCompany": true,
  "complianceStatement": "The original is relevanceai.com, a real company. Never reproduce Relevance AI's (or any real company's) logos, product screenshots, mascot, people's photos or copy. Customer, press, analyst, certification and integration marks must be generated fictional wordmarks/glyphs; photos must be licensed stock without visible brand marks; videos are poster + placeholder only.",
  "generationPolicies": {
    "reuse-exact": "Use the repo's own fictional Lumenfold asset unchanged (primitive render). Never redraw, never substitute the original site's mark or mascot.",
    "generate-fictional-mark": "Procedurally generated glyph plus an invented name (primitive.wordmark / app-icon / seal). Never a real company, product, publication, analyst or certification body name or logo.",
    "generate-illustrated-person": "Illustrated SVG avatar from primitive.avatar seeds. Never a photograph, never a real or identifiable person, never a real employee or customer of the original site.",
    "licensed-stock-no-marks": "Licensed stock photo (Unsplash licence via Lorem Picsum, as shipped in public/assets/photos) showing no visible brand mark, logo, UI of a real product, or identifiable real customer/employee. Reuse a shipped file or a newly licensed equivalent; never the original site's photos or screenshots.",
    "generate-original-illustration": "New SVG/CSS diagram or product mock drawn from tokens. Never a screenshot or trace of the original product UI.",
    "poster-placeholder-only": "A still poster (a licensed-stock photo) plus the placeholder modal. Never embed, link or transcribe a real video (the original used YouTube embeds)."
  },
  "roles": {
    "brand.logo": {
      "generationPolicy": "reuse-exact",
      "complianceCritical": true,
      "refRule": {
        "refConst": "primitive.logo"
      },
      "usedIn": [
        "src/components/ui.jsx",
        "src/components/Navbar.jsx",
        "src/components/Footer.jsx"
      ],
      "description": "Lumenfold hex mark + \"lumenfold\" wordmark.",
      "citation": "cite.ui-logomark"
    },
    "brand.mascot": {
