{
  "version": "1.0.0",
  "note": "Each rule id here is implemented under the same id in schema/semantic_validate.py; verify_all.py fails if the two sets diverge.",
  "rules": [
    {
      "id": "NAV_FIRST",
      "severity": "error",
      "rule": "shell.navbar is the first node, exactly once.",
      "scope": "Every template (App.jsx mounts Navbar once).",
      "citation": "cite.app-shell"
    },
    {
      "id": "FOOTER_LAST",
      "severity": "error",
      "rule": "shell.footer is the last node, exactly once, on every template whose footer flag is true.",
      "scope": "All templates except template.specialist-agents.",
      "citation": "cite.app-shell"
    },
    {
      "id": "FOOTER_ABSENT_NO_FOOTER_TEMPLATES",
      "severity": "error",
      "rule": "Templates with footer:false must not contain shell.footer.",
      "scope": "template.specialist-agents (App.jsx NO_FOOTER). ia.json still lists a footer there; that note is stale.",
      "citation": "cite.app-nofooter",
      "exceptions": [
        "template.specialist-agents"
      ]
    },
    {
      "id": "ONE_HERO",
      "severity": "error",
      "rule": "At most one HERO-category node per page. Hero-less templates are legitimate (named exceptions: hero not required).",
      "scope": "Hero-less templates listed in exceptions.",
      "citation": "cite.home-order",
      "exceptions": [
        "template.bdr-waitlist",
        "template.blog-article",
        "template.book-a-demo",
        "template.bulk-run",
        "template.changelog",
        "template.comparison-index",
        "template.contact-support",
        "template.event-detail",
        "template.legal",
        "template.not-found",
        "template.note-article",
        "template.specialist-agents",
        "template.tools",
        "template.workflows-index"
      ]
    },
    {
      "id": "HERO_FOLLOWS_NAV",
      "severity": "warn",
      "rule": "When a HERO node exists it directly follows shell.navbar.",
      "scope": "Templates where the first content node is not the hero are named exceptions.",
      "citation": "cite.home-order",
      "exceptions": []
    },
    {
      "id": "TEMPLATE_SEQUENCE_MATCH",
      "severity": "error",
      "rule": "nodes[] must match the declared template's node list: every required node present, order preserved, no undeclared or extra nodes, repeatable nodes at most maxRepeat.",
      "scope": "All templates.",
      "citation": "cite.app-glob"
    },
    {
      "id": "ROUTE_BOUND_TO_TEMPLATE",
      "severity": "error",
      "rule": "route must be one of the declared template's real routes (templates/routes.json).",
      "scope": "All 296 routes.",
      "citation": "cite.ia-meta"
    },
    {
      "id": "NO_EXCLUDED_ROUTES",
      "severity": "error",
      "rule": "route must not match a deliberate scope exclusion (external academy/marketplace, legacy/test pages).",
      "scope": "templates/routes.json#excluded",
      "citation": "cite.ia-exclusions"
    },
    {
      "id": "NO_REDIRECT_ONLY_ROUTES",
      "severity": "error",
      "rule": "Redirect-only routes are not pages and cannot carry a PageSpec.",
      "scope": "templates/routes.json#redirects",
      "citation": "cite.redirect-app-tools"
    },
    {
      "id": "VARIANT_ALLOWED_BY_TEMPLATE",
      "severity": "error",
      "rule": "node.variant must be one of the template node's variants (keyed on (section, variant)).",
      "scope": "Sections with parallel copies modelled as variants.",
      "citation": "cite.faq-content"
    },
    {
      "id": "NO_ADJACENT_IDENTICAL_NODE",
      "severity": "error",
      "rule": "The same (section, variant) may not appear twice in a row unless the template node is repeatable (then up to maxRepeat).",
      "scope": "features.showcase-row is repeatable (max 2).",
      "citation": "cite.spec-product",
      "exceptions": [
        "features.showcase-row"
      ]
    },
    {
      "id": "CONTINUOUS_MOTION_BUDGET",
      "severity": "warn",
      "rule": "At most 5 nodes per page may use a continuous pattern (scripted-loop, mascot-idle, marquee, carousel). Budget = maximum observed on any real template.",
      "scope": "All templates.",
      "citation": "cite.cs-continuous"
    },
    {
      "id": "REDUCED_MOTION_FALLBACK_REQUIRED",
      "severity": "error",
      "rule": "Every node declares motion.reducedMotionFallback equal to its pattern's pinned fallback.",
      "scope": "All nodes. The clone implements reduced motion in index.css and several useReducedMotion islands; the fallback is a contract requirement for generated pages.",
      "citation": "cite.css-reduced-motion"
    },
    {
      "id": "MOTION_PATTERN_ALLOWED",
      "severity": "error",
      "rule": "motion.pattern must be one of the section contract's patterns, with the pinned trigger.",
      "scope": "All nodes.",
      "citation": "cite.cs-motion"
    },
    {
      "id": "ASSET_ROLE_ALLOWED_FOR_SECTION",
      "severity": "error",
      "rule": "Every asset's assetRole must be listed in the section contract's assetRoles.",
      "scope": "All nodes with assets.",
      "citation": "cite.cs-media"
    },
    {
      "id": "ASSET_POLICY_PINNED",
      "severity": "error",
      "rule": "Every asset's generationPolicy must equal the role's pinned policy (not merely a valid policy).",
      "scope": "assets/asset-roles.json",
      "citation": "cite.cs-scope"
    },
    {
      "id": "NO_REAL_BRAND_REFERENCES",
      "severity": "error",
      "rule": "No text may name the source company (Relevance AI); generated mark names may not match any real brand observed on the original.",
      "scope": "All nodes.",
      "citation": "cite.cs-scope"
    },
    {
      "id": "FORMS_VISUAL_ONLY",
      "severity": "error",
      "rule": "Form content may not carry endpoints or URLs; forms stay visual-only.",
      "scope": "form-archetype sections.",
      "citation": "cite.form-visual"
    },
    {
      "id": "MAX_WORDS",
      "severity": "error",
      "rule": "Every text field respects the section contract's maxWords budget.",
      "scope": "All nodes.",
      "citation": "cite.content-fictional"
    },
    {
      "id": "VARIANT_CONTENT_COHERENCE",
      "severity": "error",
      "rule": "conversion.grain-cta: palette only on function-palette; titleAccent only on violet.",
      "scope": "conversion.grain-cta",
      "citation": "cite.cta-product"
    },
    {
      "id": "OBSERVED_ADJACENCY",
      "severity": "warn",
      "rule": "Adjacent pairs should be ones observed on a real template (graph.observedAdjacency).",
      "scope": "All nodes.",
      "citation": "cite.home-order"
    },
    {
      "id": "ADJACENT_CONVERSION",
      "severity": "warn",
      "rule": "Two CONVERSION nodes in a row are discouraged except the observed pairs.",
      "scope": "Named exceptions are the real occurrences.",
      "citation": "cite.spec-company",
      "exceptions": [
        "conversion.grain-cta>conversion.partner-apply",
        "conversion.legacy-next-steps>conversion.start-button-row"
      ]
    }
  ],
  "continuousMotionBudget": 5,
  "continuousPatterns": [
    "scripted-loop",
    "mascot-idle",
    "marquee",
    "carousel"
  ],
  "heroLessTemplates": [
    "template.bdr-waitlist",
    "template.blog-article",
    "template.book-a-demo",
