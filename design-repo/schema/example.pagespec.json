        "title": "Set up Pipewise in three steps",
        "body": "Most teams connect, test and hand the app to an agent in under ten minutes.",
        "steps": [
          {
            "title": "Sign in and approve access",
            "body": "Choose Pipewise from the library, sign in with an admin account and confirm the scopes your agents will be allowed to use."
          },
          {
            "title": "Pick the tools to share",
            "body": "Select which actions and triggers each agent may call. Leave anything sensitive switched off, or require a human approval before it runs."
          },
          {
            "title": "Run a test task",
            "body": "Ask an agent to complete one small job, review every step in the timeline, then turn the connection on for your whole team."
          }
